# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=base_user
DB_PASS=your_password_here
MASTER_DB_NAME=base_master
DEFAULT_DB_NAME=base_business

# JWT — minimum 32 characters!
JWT_SECRET_KEY=your-minimum-32-character-secret-key-here

# Auth
AUTH_REG_API_KEY=your-registration-api-key

# Storage Provider: "local" or "s3"
STORAGE_PROVIDER=local

# Local Storage (when STORAGE_PROVIDER=local)
LOCAL_UPLOAD_PATH=/app/uploads
LOCAL_BASE_URL=http://localhost:5000/uploads

# AWS S3 (when STORAGE_PROVIDER=s3)
S3_BUCKET_NAME=your-bucket-name
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BASE_URL=https://your-bucket.s3.ap-southeast-1.amazonaws.com

# CORS — comma-separated origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
